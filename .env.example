# Create an application at https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands instantly in a development server
DISCORD_GUILD_ID=
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this key with backups; changing it makes stored webhook tokens unreadable.
ENCRYPTION_KEY=
DATABASE_PATH=./data/hookmeup.sqlite
REDDIT_MODE=test
# Only fill after explicit written approval covering THIS use and each subreddit.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=HookMeUp/1.0 by u/YOUR_USERNAME
REDDIT_APPROVAL_REFERENCE=
REDDIT_APPROVED_SUBREDDITS=
# Actual approval expiry; required in approved mode. Never invent an expiry.
REDDIT_APPROVAL_EXPIRES_AT=
# Public API sunsets March 2027. Exceptional access after this needs written approval.
REDDIT_POST_SUNSET_APPROVED=false
REDDIT_REQUESTS_PER_MINUTE=30
LOG_LEVEL=info
